      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "title": "Enqueued Platform Jobs",
      "type": "stat",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "forgeops_jobs_total",
          "refId": "A"
        }
      ]
    },
    {
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "title": "Pod Restarts (5m)",
      "type": "stat",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(changes(kube_pod_container_status_restarts_total{namespace=~\"forgeops-.*\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 6 },
      "id": 4,
      "title": "Container CPU Utilization by Pod",
      "type": "timeseries",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=~\"forgeops-.*\"}[5m])) by (pod)",
          "refId": "A"
        }
      ]
    }
